PORT=8080
DATABASE_URL=postgresql://sariko_app:sariko_app@localhost:5432/sariko
SUPERUSER_MIGRATIONS_DATABASE_URL=postgresql://sariko:sariko@localhost:5432/sariko
JWT_SECRET=local-dev-secret-change-in-production
# Comma-separated list of origins allowed to call this API cross-origin (the
# deployed frontend's URL(s)). Local dev doesn't need this — the frontend's
# next.config.ts rewrite proxy makes local requests same-origin.
FRONTEND_ORIGIN=
