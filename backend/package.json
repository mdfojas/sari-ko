{
  "name": "sariko-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate:create": "node-pg-migrate create -m db/migrations -j sql",
    "migrate:up": "node-pg-migrate up -m db/migrations --envPath .env -d SUPERUSER_MIGRATIONS_DATABASE_URL",
    "migrate:down": "node-pg-migrate down -m db/migrations --envPath .env -d SUPERUSER_MIGRATIONS_DATABASE_URL",
    "test": "vitest run"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "fastify": "^5.1.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.20.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  }
}
